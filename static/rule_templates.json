    "enableMultiRoads": true,
    "chapterRoads": ["@js:\r\n(async () => {\r\n let praseResult = [];\r\n let Roads = await xpath(result, \"//div[contains(@class,\\\"anthology-tab\\\")]/div/a/text()\");\r\n let ChapterList = await xpath(result, \"//div[contains(@class,\\\"anthology-list-box\\\")]/node()\");\r\n // print(ChapterList[1]);\r\n\r\n for (let index = 0; index < ChapterList.length; index++) {\r\n let item_road = [];\r\n let list = (await xpath(ChapterList[index], \"//ul/li/node()\"));\r\n for (let j = 0; j < list.length; j++) {\r\n let title = (await xpath(list[j], \"//a/text()\")).join('');\r\n let url = (await xpath(list[j], \"//a/@href\")).join('');\r\n item_road.push({\r\n 'title': title,\r\n 'url': url,\r\n });\r\n }\r\n praseResult.push({\r\n 'roadName': Roads[index],\r\n 'items': item_road,\r\n });\r\n }\r\n // print(JSON.stringify(praseResult));\r\n return praseResult;\r\n})()\r\n"],
    "chapterRoadName": ["$.roadName"],
    "chapterList": ["$.items"],
    "chapterName": ["$.title"],
    "chapterResult": ["$.url"],
    "contentItems": ["@js:lastResult@filter:(?:\\.m3u8\\?|\\.mp4|index.m3u8$|jhyun.m3u8|playlist.m3u8$|\\.m3u8$)@json:$..url@replace:.*?url=|.*?v=@js:let url = decodeURIComponent(result);if(url.startsWith(\"//\")) url = \"https:\"+ url; url.replace(\".mp4&\", \".mp4?\").replace(\".m3u8&\", \".m3u8?\")"]
