{
  "version": "1.0.0",
  "lastUpdate": "2024-01-20T10:00:00Z",
  "description": "规则模板集合",
  "templates": [
    {
      "id": "maccms_v10_default",
      "name": "MacCMS v10 默认模板",
      "description": "适用于MacCMS v10系统的通用模板",
      "contentType": 2,
      "enableDiscover": true,
      "discoverList": [".module-item", ".stui-vodlist__item"],
      "discoverName": [".module-item-title@text", ".stui-vodlist__title a@text"],
      "discoverCover": [".module-item-pic img@data-original", ".stui-vodlist__thumb img@data-original"],
      "discoverResult": [".module-item-title a@href", ".stui-vodlist__title a@href"],
      "enableSearch": true,
      "searchList": [".module-item", ".stui-vodlist__media"],
      "searchName": [".module-item-title@text", "h3 a@text"],
      "searchCover": [".module-item-pic img@data-original", ".thumb img@data-original"],
      "searchResult": [".module-item-title a@href", ".thumb a@href"],
      "enableMultiRoads": true,
      "chapterRoads": [".stui-content__playlist", ".play-source"],
      "chapterRoadName": ["@text", "span@text"],
      "chapterList": ["li", "a"],
      "chapterName": ["a@text", "@text"],
      "chapterResult": ["a@href", "@href"],
      "contentItems": ["@js:lastResult@filter:(?:m3u8|mp4|video)(?:$|/|\\?|&)@json:$..url"]
    },
    {
      "id": "dplayer_template",
      "name": "DPlayer播放器模板",
      "description": "适用于使用DPlayer播放器的网站",
      "contentType": 2,
      "enableDiscover": true,
      "discoverList": [".video-item", ".movie-item"],
      "discoverName": [".video-title@text", ".movie-title@text"],
      "discoverCover": [".video-thumb img@src", ".movie-thumb img@src"],
      "discoverResult": [".video-item a@href", ".movie-item a@href"],
      "enableSearch": true,
      "searchList": [".search-item", ".result-item"],
      "searchName": [".search-title@text", ".result-title@text"],
      "searchCover": [".search-thumb img@src", ".result-thumb img@src"],
      "searchResult": [".search-item a@href", ".result-item a@href"],
      "enableMultiRoads": true,
      "chapterRoads": [".player-source", ".source-tab"],
      "chapterRoadName": ["@text", "span@text"],
      "chapterList": ["li", ".episode-item"],
      "chapterName": ["a@text", "span@text"],
      "chapterResult": ["a@href", "@data-url"],
      "contentItems": ["@js:lastResult@filter:(?:\\.m3u8||\\.mp4)@json:$..url"]
    },
    {
      "id": "streamlab_enhanced",
      "name": "Streamlab 增强模板",
      "description": "针对Streamlab类型网站的增强模板",
      "contentType": 2,
      "enableDiscover": true,
      "discoverList": [".module-item", ".video-card"],
      "discoverName": [".module-item-title@text", ".video-title@text"],
      "discoverCover": [".module-item-pic img@data-original@js:let url=result;if(url.startsWith(\"/\"))url=host+result;url", ".video-thumb img@src"],
      "discoverResult": ["a@href", ".video-link@href"],
      "enableSearch": true,
      "searchList": [".public-list-box", ".search-result-item"],
      "searchName": [".public-list-exp img@alt", ".result-title@text"],
      "searchCover": [".public-list-exp img@data-src", ".result-thumb img@src"],
      "searchResult": [".public-list-exp@href", ".result-link@href"],
      "enableMultiRoads": true,
      "chapterRoads": ["@js:\r\n(async () => {\r\n let praseResult = [];\r\n let Roads = await xpath(result, \"//div[contains(@class,'anthology-tab')]/div/a/text()\");\r\n let ChapterList = await xpath(result, \"//div[contains(@class,'anthology-list-box')]/node()\");\r\n for (let index = 0; index < ChapterList.length; index++) {\r\n let item_road = [];\r\n let list = (await xpath(ChapterList[index], \"//ul/li/node()\"));\r\n for (let j = 0; j < list.length; j++) {\r\n let title = (await xpath(list[j], \"//a/text()\")).join('');\r\n let url = (await xpath(list[j], \"//a/@href\")).join('');\r\n item_road.push({\r\n 'title': title,\r\n 'url': url,\r\n });\r\n }\r\n praseResult.push({\r\n 'roadName': Roads[index],\r\n 'items': item_road,\r\n });\r\n }\r\n return praseResult;\r\n})()"],
      "chapterRoadName": ["$.roadName"],
      "chapterList": ["$.items"],
      "chapterName": ["$.title"],
      "chapterResult": ["$.url"],
      "contentItems": ["@js:lastResult@filter:(?:\\.m3u8\\?|\\.mp4|index.m3u8$|playlist.m3u8$|\\.m3u8$)@json:$..url@replace:.*?url=|.*?v=@js:let url = decodeURIComponent(result);if(url.startsWith(\"//\")) url = \"https:\"+ url; url.replace(\".mp4&\", \".mp4?\").replace(\".m3u8&\", \".m3u8?\")"]
    },
    {
      "id": "simple_video_site",
      "name": "简单视频站模板",
      "description": "适用于简单结构的视频网站",
      "contentType": 2,
      "enableDiscover": true,
      "discoverList": [".video-list li", ".movie-grid .item"],
      "discoverName": [".title@text", ".name@text"],
      "discoverCover": ["img@src", ".poster img@src"],
      "discoverResult": ["a@href", ".link@href"],
      "enableSearch": true,
      "searchList": [".search-results li", ".search-grid .item"],
      "searchName": [".title@text", ".name@text"],
      "searchCover": ["img@src", ".poster img@src"],
      "searchResult": ["a@href", ".link@href"],
      "enableMultiRoads": false,
      "chapterRoads": [],
      "chapterRoadName": [],
      "chapterList": [".episode-list li", ".play-list a"],
      "chapterName": ["@text", "span@text"],
      "chapterResult": ["a@href", "@href"],
      "contentItems": ["@js:lastResult@filter:(?:m3u8|mp4)@json:$..url"]
    }
  ]
} 
